---
import Icon from './Icon.astro';
import { company } from '../data/site';
import { EMAIL_PATTERN, LIMITS } from '../data/contact';

const details = [
  { icon: 'mail', label: 'Email', value: company.email, href: `mailto:${company.email}` },
  { icon: 'phone', label: 'Phone', value: company.phone, href: `tel:${company.phone.replace(/[^+\d]/g, '')}` },
  { icon: 'pin', label: 'Office', value: company.address },
] as const;

const inputClass =
  'mt-2 block w-full rounded-xl border border-ink-200 bg-white px-4 py-3 text-ink-950 placeholder:text-ink-300 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30 focus:outline-none';
---

<section id="contact" class="bg-ink-50 section-screen">
  <div class="container-x grid gap-14 lg:grid-cols-5 lg:gap-20">
    <div class="lg:col-span-2" data-reveal>
      <p class="eyebrow text-brand-600">Contact us</p>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight text-balance sm:text-5xl">Request a free quote</h2>
      <p class="mt-5 text-lg text-ink-700">
        Share your project scope and drawings requirement, and our team will get back to you with a quote within one
        business day.
      </p>

      <ul class="mt-10 space-y-6">
        {
          details.map((d) => (
            <li class="flex gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-ink-950 text-brand-400">
                <Icon name={d.icon} class="size-5" />
              </span>
              <span>
                <span class="block text-sm text-ink-500">{d.label}</span>
                {'href' in d ? (
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <a href={d.href} class="font-semibold break-all hover:text-brand-700">
                      {d.value}
                    </a>
                    {/* mailto/tel do nothing when no mail or phone app is set up, so offer a copy fallback */}
                    <button
                      type="button"
                      data-copy={d.value}
                      class="w-17 rounded-full border border-ink-200 py-0.5 text-center text-xs font-semibold whitespace-nowrap text-ink-600 transition hover:border-brand-500 hover:text-brand-700"
                      aria-label={`Copy ${d.label.toLowerCase()}`}
                    >
                      Copy
                    </button>
                  </span>
                ) : (
                  <span class="font-semibold">{d.value}</span>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      id="contact-form"
      data-reveal
      style="--reveal-delay: 120ms"
      action="/api/contact"
      method="post"
      class="flex flex-col rounded-3xl bg-white p-6 shadow-xl shadow-ink-900/5 sm:p-10 lg:col-span-3"
    >
      <div class="grid gap-6 sm:grid-cols-2">
        <label class="block text-sm font-semibold">
          Name
          <input
            name="name"
            type="text"
            required
            minlength={LIMITS.name.min}
            maxlength={LIMITS.name.max}
            autocomplete="name"
            placeholder="Your full name"
            class={inputClass}
          />
        </label>
        <label class="block text-sm font-semibold">
          Email
          <input
            name="email"
            type="email"
            required
            maxlength={LIMITS.email.max}
            pattern={EMAIL_PATTERN}
            title="Enter a valid email address, e.g. you@company.com"
            autocomplete="email"
            placeholder="you@company.com"
            class={inputClass}
          />
        </label>
      </div>
      <!-- The message box grows to fill the card, so it lines up with the contact details column. -->
      <div class="mt-6 flex flex-1 flex-col">
        <label class="flex flex-1 flex-col text-sm font-semibold">
          Message
          <textarea
            name="message"
            required
            rows="6"
            minlength={LIMITS.message.min}
            maxlength={LIMITS.message.max}
            placeholder="Tell us about your project, location and timeline"
            class:list={[inputClass, 'flex-1 resize-none']}></textarea>
        </label>
        <p id="message-count" class="mt-1.5 self-end text-xs text-ink-400" aria-live="polite">
          0 / {LIMITS.message.max.toLocaleString('en-US')}
        </p>
      </div>

      <!-- Honeypot: hidden from people, bots tend to fill it in. -->
      <div class="hidden" aria-hidden="true">
        <label>Company website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button type="submit" class="btn-primary mt-8 self-start whitespace-nowrap disabled:cursor-wait disabled:opacity-60">
        <span data-label>Send message</span>
        <Icon name="arrow" class="size-4" />
      </button>
      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="mt-5 hidden items-start gap-3 rounded-xl border px-4 py-3 text-sm font-medium data-[kind=error]:border-red-200 data-[kind=error]:bg-red-50 data-[kind=error]:text-red-700 data-[kind=success]:border-brand-300 data-[kind=success]:bg-brand-50 data-[kind=success]:text-brand-700 data-kind:flex"
      >
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const label = button.querySelector('[data-label]')!;

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied!';
      } catch {
        btn.textContent = 'Failed';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    }),
  );

  const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
  const count = document.getElementById('message-count')!;
  const updateCount = () => {
    count.textContent = `${message.value.length.toLocaleString('en-US')} / ${message.maxLength.toLocaleString('en-US')}`;
  };
  message.addEventListener('input', updateCount);

  const setStatus = (kind: 'success' | 'error' | null, message = '') => {
    status.textContent = message;
    if (kind) status.dataset.kind = kind;
    else delete status.dataset.kind;
  };

  const params = new URLSearchParams(location.search);
  if (params.has('sent')) {
    const ok = params.get('sent') === '1';
    setStatus(ok ? 'success' : 'error', ok ? 'Thanks! Your message has been sent.' : 'Sorry, something went wrong. Please email us directly.');
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    button.disabled = true;
    label.textContent = 'Sending…';
    setStatus(null);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error ?? 'Something went wrong. Please try again.');
      form.reset();
      updateCount();
      setStatus('success', "Thanks! Your message has been sent. We'll be in touch soon.");
    } catch (error) {
      setStatus('error', (error as Error).message);
    } finally {
      button.disabled = false;
      label.textContent = 'Send message';
    }
  });
</script>
