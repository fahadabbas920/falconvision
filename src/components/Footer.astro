---
import Logo from './Logo.astro';
import { company, nav, services } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-ink-950 text-white">
  <div class="container-x grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo size={80} />
      <p class="mt-5 max-w-sm text-sm text-white/60">{company.description}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold tracking-wider text-brand-400 uppercase">Company</h2>
      <ul class="mt-4 space-y-3 text-sm">
        {nav.map((item) => <li><a href={item.href} class="text-white/70 hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold tracking-wider text-brand-400 uppercase">Services</h2>
      <ul class="mt-4 space-y-3 text-sm text-white/70">
        {services.map((s) => <li>{s.title}</li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-white/50 sm:flex-row sm:justify-between">
      <p>&copy; {year} {company.name}. All rights reserved.</p>
      <p><a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a></p>
    </div>
  </div>
</footer>
