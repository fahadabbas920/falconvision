---
import { Image } from 'astro:assets';
import logo from '../assets/brand/falcon-vision-logo.png';

interface Props {
  class?: string;
  /** Rendered height of the badge in px. */
  size?: number;
}

const { class: className = '', size = 52 } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <Image
    src={logo}
    alt=""
    height={size}
    densities={[1, 2, 3]}
    loading="eager"
    class="shrink-0"
    style={{ height: `${size}px`, width: 'auto' }}
  />
  <span class="leading-none">
    <span class="block text-base font-extrabold tracking-tight">FALCON VISION</span>
    <span class="mt-1 block text-[0.6rem] font-semibold tracking-[0.3em] opacity-70">ENGINEERING LLC</span>
  </span>
</span>
